# Public DNS name pointing at this server (A record), used for the portal, ID server and relay.
RUSTDESK_HOST=remote.ylts.com.au
# Let's Encrypt contact
ACME_EMAIL=hello@ylts.com.au

# Generate these three with: python3 scripts/genkeys.py
PORTAL_SECRET_KEY=
PORTAL_ENCRYPTION_KEY=
# First admin account (only used when the database is empty). Change the password after first sign-in.
BOOTSTRAP_ADMIN_USER=david
BOOTSTRAP_ADMIN_PASSWORD=

# Shown to clients in the YLTS tray icon menu
COMPANY_NAME=Your Local Tech Solutions
SUPPORT_PHONE=0483 866 665
SUPPORT_EMAIL=hello@ylts.com.au
SUPPORT_URL=https://ylts.com.au

# Technician app sign-ins last this many days
TOKEN_DAYS=30
